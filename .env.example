# Copy this file to .env and supply a different random value for each blank secret.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_ADMIN_EMAIL=admin@ecomops.test
MEDUSA_ADMIN_PASSWORD=
ECOMOPS_API_TOKEN=

# Only publish to the loopback interface. These are host ports.
MEDUSA_PORT=9000
ECOMOPS_PORT=8100

# Leave blank to use ECOMOPS_API_TOKEN, or supply a JSON object with role accounts.
ECOMOPS_ACCOUNTS=

# Blank uses the persisted SQLite volume. A PostgreSQL URL enables ecomops_agent.
ECOMOPS_DATABASE_URL=

# Enable both flags only on a disposable deployment of the supplied demo fixtures.
ECOMOPS_ISOLATED_FIXTURES=0
ECOMOPS_ALLOW_REPLENISHMENT=0

# Opt in to the read-only MCP tools for saved reports.
ECOMOPS_MCP_REPORT_READ=0

# Optional reporting schedule. Set both a zone (e.g. Asia/Shanghai) and hour (0-23).
ECOMOPS_REPORT_ZONE=
ECOMOPS_REPORT_HOUR=

# Optional language-model interpretation. Protocol defaults to openai or can be ollama.
ECOMOPS_LLM_PROTOCOL=
ECOMOPS_LLM_URL=
ECOMOPS_LLM_MODEL=
ECOMOPS_LLM_API_KEY=
